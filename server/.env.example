# Copy this file to .env and change the values
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/learnhub
# Use a long random string for the JWT secret
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Frontend address (CORS). Use commas for more than one address
CLIENT_URL=http://localhost:5173
# Set to production when serving the built React app from this server
# NODE_ENV=production

# Used only by "npm run seed" to create the first admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@learnhub.com
ADMIN_PASSWORD=Admin@123
